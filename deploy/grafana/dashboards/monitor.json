{
  "title": "YOLO VLM Monitor",
  "uid": "yolo-vlm-monitor",
  "schemaVersion": 41,
  "refresh": "10s",
  "panels": [
    {"type":"stat","title":"Online Cameras","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"monitor_cameras_online"}]},
    {"type":"timeseries","title":"Task Rate","gridPos":{"x":6,"y":0,"w":9,"h":8},"targets":[{"expr":"rate(monitor_tasks_total[5m])","legendFormat":"{{status}}"}]},
    {"type":"timeseries","title":"Analysis P95","gridPos":{"x":15,"y":0,"w":9,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(monitor_analysis_seconds_bucket[5m])) by (le))"}]},
    {"type":"timeseries","title":"VLM Calls","gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"expr":"rate(monitor_vlm_calls_total[5m])","legendFormat":"{{mode}} / {{status}}"}]},
    {"type":"timeseries","title":"Queue Depth","gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"monitor_queue_depth","legendFormat":"{{priority}}"}]}
  ]
}

