FROM node:22-alpine AS web
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-yolo.txt ./
RUN python3 -m pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu124 && python3 -m pip install --no-cache-dir -r requirements-yolo.txt
COPY backend ./backend
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
COPY run.py ./run.py
COPY --from=web /src/frontend/dist ./frontend/dist
RUN mkdir -p /app/data/evidence /app/models
EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8100/health')"
CMD ["python3", "run.py"]
