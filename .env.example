APP_HOST=127.0.0.1
APP_PORT=8100
# 数据库（本地裸跑连接串；生产 Docker Compose 会自动覆盖为容器内 postgres 服务地址）
DATABASE_URL=postgresql+psycopg://monitor:monitor_pass@127.0.0.1:5432/monitor
# 生产 Docker Compose 的 PostgreSQL 密码（必须修改，勿用默认值）
POSTGRES_PASSWORD=monitor_pass
REDIS_URL=redis://127.0.0.1:6379/0
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
EVIDENCE_DIR=./data/evidence
EVIDENCE_RETENTION_DAYS=30
YOLO_MODEL_PATH=models/yolo26s.pt
YOLO_DEVICE=cpu
YOLO_IMGSZ=640
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.5
YOLO_INFERENCE_TIMEOUT_SECONDS=30
ANALYSIS_QUEUE_MAXSIZE=256
FIRE_SMOKE_MODEL=models/fire_smoke_yolov8.pt
FIRE_SMOKE_SHA256=ac0a10257b2bc1f20c9d957f8adeeb61dd6140322fc19d0b4a116cb491776d16
FIRE_SMOKE_DEVICE=cpu
FIRE_SMOKE_IMGSZ=640
SCHEDULER_ENABLED=true
ANALYSIS_WORKERS=2
FIRE_SMOKE_WORKERS=1
MAX_LIVE_PREVIEWS=4
LIVE_PREVIEW_FPS=2
LIVE_PREVIEW_TIMEOUT_SECONDS=60
FRAME_CAPTURE_TIMEOUT_SECONDS=15
WEB_DIST_DIR=./frontend/dist
