# syntax=docker/dockerfile:1
FROM docker.m.daocloud.io/library/node:22-alpine AS web
# corepack 下载 pnpm 本体也走国内源
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /src/frontend
RUN corepack enable
# 只先复制依赖清单，最大化利用层缓存（源码变动不会触发重新装依赖）
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm run build

FROM docker.m.daocloud.io/library/python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN sed -i "s|http://deb.debian.org|http://mirrors.aliyun.com|g" /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-yolo.txt ./
# 先装 torch CPU 版（单独成层，依赖文件不变时命中缓存）
RUN pip install --no-cache-dir --progress-bar off \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.13.0+cpu torchvision==0.28.0+cpu
# ultralytics 声明的 torch 依赖已被上面的版本满足，pip 不会重复下载
RUN pip install --no-cache-dir --progress-bar off --index-url https://mirrors.aliyun.com/pypi/simple/ -r requirements-yolo.txt
COPY backend ./backend
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
COPY run.py ./run.py
COPY --from=web /src/frontend/dist ./frontend/dist
RUN mkdir -p /app/data/evidence /app/models
EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8100/health')"
CMD ["python", "run.py"]
